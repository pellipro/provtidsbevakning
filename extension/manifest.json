{
  "manifest_version": 3,
  "name": "Provtidsbevakning för Trafikverket",
  "version": "1.1.0",
  "description": "Larmar när en ledig provtid dyker upp i Trafikverkets bokning. Bokar ingenting, du bokar själv.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://fp.trafikverket.se/Boka/*"],
      "js": ["bevakning.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN"
    }
  ]
}
